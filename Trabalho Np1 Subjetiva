#include <stdio.h>
#include <math.h>

int main() {
    float distancia, consumo, preco, capacidade;
    float autonomia, litros_gastos_total, sobra;
    float custo_total;
    int ar_ligado;

    // Entrada de dados
    printf("Distancia de IDA (km): ");
    scanf("%f", &distancia);

    printf("Consumo do carro na gasolina (km/l): ");
    scanf("%f", &consumo);

    printf("Capacidade do tanque (litros): ");
    scanf("%f", &capacidade);

    printf("Preco do litro da gasolina: R$ ");
    scanf("%f", &preco);

    printf("Ar-condicionado ligado? (1-Sim / 0-Nao): ");
    scanf("%d", &ar_ligado);

    // Ajuste de consumo (Ar consome ~15% mais)
    float consumo_ajustado = ar_ligado == 1 ? consumo * 0.85 : consumo;

    // Cálculos para o trajeto TOTAL (Ida + Volta)
    float distancia_total = distancia * 2;
    litros_gastos_total = distancia_total / consumo_ajustado;
    autonomia = capacidade * consumo_ajustado;
    custo_total = litros_gastos_total * preco;
    sobra = capacidade - litros_gastos_total;

    // Saída
    printf("\n--- ANALISE DE COMBUSTIVEL (IDA E VOLTA) ---");
    printf("\nDistancia total: %.2f km", distancia_total);
    printf("\nConsumo real: %.2f km/l", consumo_ajustado);
    printf("\nLitros totais necessarios: %.2f L", litros_gastos_total);
    printf("\nCusto total da viagem: R$ %.2f\n", custo_total);

    // Verificação se o tanque aguenta o trajeto todo
    if (litros_gastos_total > capacidade) {
        printf("\nALERTA: O tanque NAO e suficiente para ida e volta.");
        printf("\nFaltarao aproximadamente %.2f litros.\n", (litros_gastos_total - capacidade));
    } else {
        printf("\nSUCESSO: O tanque e suficiente para todo o trajeto!");
        printf("\nSobra estimada ao chegar: %.2f litros.\n", sobra);
    }

    return 0;
}
